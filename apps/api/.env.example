# For local development only. Never commit a real .env file or credentials.
# Copy this file to apps/api/.env and fill in secrets locally.
DATABASE_URL=
# Generate with: openssl rand -base64 48 (at least 32 random bytes).
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
# Local development only. Production registration is separately gated on verified email and Turnstile.
NODE_ENV=development
ENABLE_DEV_SIGNUP=false
# Production signup: only enable AFTER verified sender, Turnstile and E2E validation.
ENABLE_PUBLIC_SIGNUP=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PORT=3001
