AUTH_SECRET=
WEB_ORIGIN=http://localhost:5173
PORT=3001

# Direct Neon connection for LISTEN/NOTIFY when DATABASE_URL uses the pooler.
# REALTIME_DATABASE_URL=postgresql://...
# Shared with the private attachment Worker. Generate a distinct random value.
# FILES_SECRET=...

# Transactional verification email. Use a sender verified in Resend.
# RESEND_API_KEY=...
# AUTH_EMAIL_FROM=Uorqui <conta@your-domain.example>
