# For local development only. Never commit a real .env file or credentials.
# Copy this file to apps/api/.env and fill in secrets locally.
DATABASE_URL=
# Generate with: openssl rand -base64 48 (at least 32 random bytes).
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
# Local development only. Registration is always disabled when NODE_ENV=production.
NODE_ENV=development
ENABLE_DEV_SIGNUP=false
PORT=3001
