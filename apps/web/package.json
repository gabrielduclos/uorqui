{
  "name": "@uorqui/web",
  "version": "0.1.0-beta.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:instance": "node --import tsx --test test/app-instance-identity.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:channel-scroll": "node --import tsx --test test/channel-scroll.test.mjs",
    "test:channel-theme": "node --test test/channel-nav-theme.test.mjs",
    "test:message-time": "node --import tsx --test test/message-timestamp.test.mjs",
    "test:image": "node --import tsx --test test/image-compression.test.mjs",
    "test:notifications": "node --test test/notification-channel-regression.test.mjs",
    "preview": "vite preview",
    "check:worker": "wrangler deploy --dry-run",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.8.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "wrangler": "^4.148.0",
    "@types/node": "^22.15.0",
    "tw-animate-css": "^1.4.0"
  }
}
