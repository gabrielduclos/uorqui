{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "main",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "vars": {
    "API_ORIGIN": "https://uorqui-social-api.onrender.com"
  },
  "r2_buckets": [
    { "binding": "PROFILE_MEDIA", "bucket_name": "uorqui-profile-media" },
    { "binding": "DM_ATTACHMENTS", "bucket_name": "uorqui-dm-attachments" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/@*",
      "/%40*",
      "/auth/email-verification",
      "/auth/email-verification/",
      "/media/profile/*",
      "/media/community/*",
      "/media/community-attachment/*",
      "/media/feed/*",
      "/media/dm/*",
      "/health",
      "/health/*"
    ]
  }
}
