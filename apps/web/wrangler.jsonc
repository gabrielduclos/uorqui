{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "main",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "vars": {
    "API_ORIGIN": "https://uorqui-social-api.onrender.com"
  },
  "r2_buckets": [{ "binding": "PROFILE_MEDIA", "bucket_name": "uorqui-profile-media" }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/@*",
      "/%40*",
      "/media/profile/*",
      "/health",
      "/health/*"
    ]
  }
}
