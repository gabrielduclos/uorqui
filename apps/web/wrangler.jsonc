{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "main",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*"
    ]
  }
}
