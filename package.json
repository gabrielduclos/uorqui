{
  "name": "uorqui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @uorqui/api\" \"npm run dev -w @uorqui/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w @uorqui/api",
    "db:migrate": "npm run db:migrate -w @uorqui/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0"
  }
}
